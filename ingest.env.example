# Copy to ingest.env on each laptop and fill in. Do not share or commit ingest.env.
# Token needs scopes: reverb etsy and this laptop's stores. One token per laptop, with no
# owner, so the laptop runs that store's jobs from every user (oldest first):
#   python manage.py create_ingest_token --label worker-1 --scopes reverb etsy --stores IQ IQR

INGEST_BASE_URL=https://sellerpilothub.com/api/v1/ingest/
INGEST_TOKEN=

# Bot folders on this laptop. Leave one empty to run only the other marketplace.
REVERB_BOT_DIR=C:\Listing Bot\Reverb
ETSY_BOT_DIR=C:\Listing Bot\Etsy

# Optional. Default: the bot folder's .venv\Scripts\python.exe, else the Python running this runner.
POLLER_PYTHON=

POLLER_INTERVAL=20
CANCEL_CHECK_EVERY=5
INGEST_TIMEOUT=60
INGEST_VERIFY_SSL=1
RUNNER_NAME=worker-1
